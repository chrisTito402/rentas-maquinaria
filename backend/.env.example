# Copia este archivo como .env y cambia TU_CONTRASEÑA por la que pusiste al instalar PostgreSQL.
DATABASE_URL=postgres://postgres:TU_CONTRASEÑA@localhost:5432/renta_equipos
PORT=3001
# Genera con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_KEY=
# En Render: URL pública exacta, sin barra final. Local: http://localhost:5173
APP_ORIGIN=http://localhost:5173
# Solo para ejecutar auth:crear-usuario. Retira estas dos variables después.
AUTH_USUARIO=
AUTH_CONTRASENA=
